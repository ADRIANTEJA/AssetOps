<Window x:Class="UI.Windows.ConfirmUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI.Windows" 
        xmlns:commonButtons="clr-namespace:UI.Controls.Buttons.Common" 
        xmlns:mainWindowButtons="clr-namespace:UI.Controls.Buttons.MainWindow"
        mc:Ignorable="d"
        Title="Confirm Update"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="300"
        Height="200"
        ResizeMode="NoResize"
        Effect="{StaticResource window_drop_shadow}"
        Loaded="OnLoadedHandler">

    <Border Background="{DynamicResource theme_background_brush}"
            BorderBrush="{StaticResource green_brush}"
            BorderThickness="1"
            CornerRadius="2">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="37"/>
            </Grid.RowDefinitions>

            <Grid MouseDown="DragMoveHandler"
                  Background="Transparent">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <mainWindowButtons:MinimizeButton Grid.Column="1"
                                                  Click="MinimizeWindowHandler"/>
                <mainWindowButtons:QuitButton Grid.Column="2"
                                              Click="CloseProgramHandler"/>
            </Grid>

            <TextBlock x:Name="update_prompt_textblock"
                       Grid.Row="1"
                       TextWrapping="Wrap"
                       Style="{StaticResource base_textblock_style}"
                       VerticalAlignment="Top" 
                       Margin="15,10,15,0"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <commonButtons:OKButton Click="OkButtonClickHandler"
                                        Width="100" 
                                        Margin="39,0,10,5"/>

                <commonButtons:CancelButton Grid.Column="1"
                                            Width="100" 
                                            Click="CancelButtonClickHandler" 
                                            Margin="10,0,39,5"/>
            </Grid>
        </Grid>
    </Border>
</Window>
